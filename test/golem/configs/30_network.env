# 网络/拓扑参数（用于 sweep）
: "${GOLEM_NUM_MEMORY_NODES:=5}"
: "${GOLEM_MEM_NODE_SIZE_BYTES:=134217728}"
# Identity window base默认与单个内存节点大小对齐（node0给OS，node1开始给数据）
: "${GOLEM_IDENTITY_BASE:=${GOLEM_MEM_NODE_SIZE_BYTES}}"

# Mesh 维度（Y 维由脚本按 core 数推导）
: "${GOLEM_MESH_DIM_X:=4}"

# NoC 路由器端口缓冲
: "${GOLEM_NOC_INPUT_BUF_SIZE:=32KB}"
: "${GOLEM_NOC_OUTPUT_BUF_SIZE:=32KB}"
# MemNIC endpoint buffers are independent from router port buffers.
: "${GOLEM_NOC_MEMNIC_INPUT_BUF_SIZE:=128KB}"
: "${GOLEM_NOC_MEMNIC_OUTPUT_BUF_SIZE:=128KB}"
# GlobalMemory NetworkIF buffer_length（对应 --gm-buf）
: "${GOLEM_GM_BUFFER_LENGTH:=32KB}"

# Bandwidth model for a 1 GHz, 128 B/flit NoC data plane. Each HBM stack has
# 8 channels x 32 B/DRAM-cycle x 1.25 GHz = 320 GB/s peak. The 512 GB/s
# memory-facing link leaves protocol headroom, and the doubled crossbar keeps
# router arbitration from becoming an artificial bottleneck.
: "${GOLEM_NOC_LINK_BW:=512GB/s}"
: "${GOLEM_NOC_XBAR_BW:=1024GB/s}"
: "${GOLEM_NOC_FLIT_SIZE:=128B}"
: "${GOLEM_DIRCTRL_HIGHLINK_BW:=512GB/s}"
# GlobalMemory 带宽
: "${GOLEM_GM_LINK_BW:=256GB/s}"

# VN1 read responses > VN0 read requests > VN2 C writes. An aged VN2
# packet bypasses the strict order so writeback cannot starve indefinitely.
: "${GOLEM_NOC_VN_PRIORITY_ENABLE:=1}"
: "${GOLEM_NOC_VN_PRIORITY_ORDER:=1,0,2}"
: "${GOLEM_NOC_VN_STARVATION_VN:=2}"
: "${GOLEM_NOC_VN_MAX_STARVATION_CYCLES:=4096}"

# NoC 分区切分约束。mesh、内存端点和请求调度端点默认保持在同一分区，
# 避免 MPI rank 数改变同时间戳的 NoC 仲裁顺序；普通 core 本地边仍可切分。
: "${GOLEM_NOC_INTER_ROUTER_NO_CUT:=1}"
: "${GOLEM_NOC_LOCAL_NO_CUT:=0}"
: "${GOLEM_NOC_MEMORY_LOCAL_NO_CUT:=1}"
: "${GOLEM_NOC_SCHED_LOCAL_NO_CUT:=1}"

# 默认使用经过 2048 GEMM 验证的拓扑连续加权分区。
# pipeline 会为显式分区自动选择 sst.self；可显式设为 0 回退到 SST 自动分区。
: "${GOLEM_EXPLICIT_PARTITION:=1}"

# GlobalMemory NetworkIF buffer_length（对应 --gm-buf）

export GOLEM_NUM_MEMORY_NODES
export GOLEM_MEM_NODE_SIZE_BYTES
export GOLEM_IDENTITY_BASE
export GOLEM_MESH_DIM_X
export GOLEM_NOC_INPUT_BUF_SIZE
export GOLEM_NOC_OUTPUT_BUF_SIZE
export GOLEM_NOC_MEMNIC_INPUT_BUF_SIZE
export GOLEM_NOC_MEMNIC_OUTPUT_BUF_SIZE
export GOLEM_NOC_LINK_BW
export GOLEM_NOC_XBAR_BW
export GOLEM_NOC_FLIT_SIZE
export GOLEM_DIRCTRL_HIGHLINK_BW
export GOLEM_GM_LINK_BW
export GOLEM_NOC_VN_PRIORITY_ENABLE
export GOLEM_NOC_VN_PRIORITY_ORDER
export GOLEM_NOC_VN_STARVATION_VN
export GOLEM_NOC_VN_MAX_STARVATION_CYCLES
export GOLEM_NOC_INTER_ROUTER_NO_CUT
export GOLEM_NOC_LOCAL_NO_CUT
export GOLEM_NOC_MEMORY_LOCAL_NO_CUT
export GOLEM_NOC_SCHED_LOCAL_NO_CUT
export GOLEM_EXPLICIT_PARTITION
export GOLEM_GM_BUFFER_LENGTH

#用nature-skill美化timeline 注意字体大小的可读性，现在字体太小，并且有图例缺失的情况。
#C writeback只需要记录4096/4096 complete和C writeback造成的尾延迟
#现在的C累加方式会对array里CU单元的设计改动吗，还是说在固定某一拍传到输出寄存器上即可
