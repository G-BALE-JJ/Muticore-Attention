{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpu_attention_stage_schema.json",
  "title": "GPU Attention Stage Benchmark Result",
  "type": "object",
  "required": ["schema_version", "benchmark", "hardware", "software", "measurement", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark": {"const": "single-head FP32 non-causal scaled dot-product attention"},
    "hardware": {
      "type": "object",
      "required": ["gpu"],
      "properties": {"gpu": {"const": "NVIDIA GeForce RTX 5060"}}
    },
    "software": {"type": "object"},
    "measurement": {
      "type": "object",
      "required": ["timer", "warmup", "iterations", "h2d_included", "d2h_included", "dtype_conversion_included", "tf32_allowed"],
      "properties": {
        "timer": {
          "const": "CUDA Event",
          "description": "Applies to clean Scope A and stage-chain measurements."
        },
        "warmup": {"type": "integer", "minimum": 1},
        "iterations": {"type": "integer", "minimum": 1},
        "h2d_included": {"const": false},
        "d2h_included": {"const": false},
        "dtype_conversion_included": {"const": false},
        "tf32_allowed": {"type": ["boolean", "null"]},
        "stream": {
          "const": "current default stream",
          "description": "Applies to every timed operation in the benchmark."
        },
        "empty_event_iterations": {"type": "integer", "minimum": 1},
        "empty_event_median_ms": {"type": "number", "exclusiveMinimum": 0},
        "empty_event_samples_ms": {"$ref": "#/$defs/samples"}
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "e3": {"$ref": "#/$defs/profile"},
        "e4": {"$ref": "#/$defs/profile"}
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["shape", "fp32_math"],
      "properties": {
        "shape": {
          "type": "object",
          "required": ["batch", "heads", "sequence", "head_dim"]
        },
        "fp32_math": {
          "type": "object",
          "required": ["evidence_level", "scope_a", "stage_chain"],
          "properties": {
            "evidence_level": {"enum": ["summary_only", "raw_samples"]},
            "scope_a": {
              "type": "object",
              "required": ["median_ms", "samples_ms", "normalization_clock_hz", "median_normalized_cycles"],
              "properties": {
                "median_ms": {"type": "number", "exclusiveMinimum": 0},
                "samples_ms": {
                  "oneOf": [
                    {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
                    {"type": "null"}
                  ]
                },
                "normalization_clock_hz": {"const": 1000000000},
                "median_normalized_cycles": {"type": "integer", "minimum": 1}
              }
            },
            "stage_chain": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": {"enum": ["measured", "pending_external_measurement"]},
                "method": {"const": "consecutive CUDA Events on one stream; one final synchronize"},
                "stage_median_ms": {
                  "type": "object",
                  "required": ["qk", "scale", "softmax", "pv"],
                  "properties": {
                    "qk": {"type": "number", "exclusiveMinimum": 0},
                    "scale": {"type": "number", "exclusiveMinimum": 0},
                    "softmax": {"type": "number", "exclusiveMinimum": 0},
                    "pv": {"type": "number", "exclusiveMinimum": 0}
                  }
                },
                "stage_samples_ms": {
                  "type": "object",
                  "required": ["qk", "scale", "softmax", "pv"],
                  "properties": {
                    "qk": {"$ref": "#/$defs/samples"},
                    "scale": {"$ref": "#/$defs/samples"},
                    "softmax": {"$ref": "#/$defs/samples"},
                    "pv": {"$ref": "#/$defs/samples"}
                  }
                },
                "end_to_end_median_ms": {"type": "number", "exclusiveMinimum": 0},
                "end_to_end_samples_ms": {"$ref": "#/$defs/samples"},
                "output_writeback": {"const": "included in the PV matmul event interval"}
              },
              "allOf": [
                {
                  "if": {"properties": {"status": {"const": "measured"}}},
                  "then": {"required": ["stage_median_ms", "stage_samples_ms", "end_to_end_median_ms", "end_to_end_samples_ms", "output_writeback"]}
                }
              ]
            },
            "correctness": {
              "type": "object",
              "required": ["passed", "output_shape", "finite", "scope_a_max_abs_error", "stage_chain_max_abs_error", "max_abs_error", "tolerance"],
              "properties": {
                "passed": {"const": true},
                "output_shape": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {"type": "integer", "minimum": 1}
                },
                "finite": {"const": true},
                "scope_a_max_abs_error": {"type": "number", "minimum": 0, "maximum": 0.000001},
                "stage_chain_max_abs_error": {"type": "number", "minimum": 0, "maximum": 0.000001},
                "max_abs_error": {"type": "number", "minimum": 0, "maximum": 0.000001},
                "tolerance": {"const": 0.000001}
              }
            }
          },
          "allOf": [
            {
              "if": {"properties": {"evidence_level": {"const": "summary_only"}}},
              "then": {
                "properties": {
                  "scope_a": {"properties": {"samples_ms": {"type": "null"}}},
                  "stage_chain": {"properties": {"status": {"const": "pending_external_measurement"}}}
                }
              }
            },
            {
              "if": {"properties": {"evidence_level": {"const": "raw_samples"}}},
              "then": {
                "properties": {
                  "scope_a": {"properties": {"samples_ms": {"$ref": "#/$defs/samples"}}},
                  "correctness": {"type": "object"},
                  "stage_chain": {
                    "required": ["method"],
                    "properties": {"status": {"const": "measured"}}
                  }
                },
                "required": ["correctness"]
              }
            }
          ]
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profiles": {
            "anyOf": [
              {"required": ["e3"], "properties": {"e3": {"properties": {"fp32_math": {"properties": {"evidence_level": {"const": "raw_samples"}}}}}}},
              {"required": ["e4"], "properties": {"e4": {"properties": {"fp32_math": {"properties": {"evidence_level": {"const": "raw_samples"}}}}}}}
            ]
          }
        }
      },
      "then": {
        "properties": {
          "measurement": {
            "required": ["stream", "empty_event_iterations", "empty_event_median_ms", "empty_event_samples_ms"]
          }
        }
      }
    }
  ]
}
