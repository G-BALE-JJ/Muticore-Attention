# DMA/流水重叠实验参数
: "${GOLEM_DMA_NODE_CHUNK_CREDITS:=128}"
# A/B panels are issued as one 16KB DMA request.  Keep the 4KB credit
# accounting below so the node-side outstanding-byte budget is unchanged.
: "${GOLEM_DMA_PANEL_CHUNK_BYTES:=16384}"
: "${GOLEM_DMA_CREDIT_CHUNK_BYTES:=4096}"

: "${GOLEM_DMA_WINDOW_PRIORITY_ENABLE:=1}"
: "${GOLEM_DMA_WINDOW_REORDER_CYCLES:=512}"

: "${GOLEM_DMA_SLOT_COUNT:=32}"
: "${GOLEM_REQUEST_SCHEDULER_QUEUE_DEPTH:=2048}"
: "${GOLEM_SCHED_ISSUE_BUDGET_PER_TICK:=8}"

: "${GOLEM_DMA_GROUP_RR_ENABLE:=1}"

: "${GOLEM_DMA_TILE_CHUNK_QUANTUM:=4}"

: "${GOLEM_DMA_RESPONSE_TILE_PRIORITY_ENABLE:=1}"
: "${GOLEM_DMA_RESPONSE_REORDER_CYCLES:=0}"
: "${GOLEM_DMA_RESPONSE_MAX_STARVATION_CYCLES:=65536}"
: "${GOLEM_DMA_ADMISSION_MAX_STARVATION_CYCLES:=4096}"

: "${GOLEM_SCHED_SUBMIT_BATCH_SIZE:=8}"
: "${GOLEM_SCHED_DONE_BATCH_SIZE:=8}"

: "${GOLEM_WCP_PREFETCH_WINDOWS:=1}"

# Explicit FP16 4x4 long-window profile (keep slots=32):
#   GOLEM_DMA_WINDOW_K_TILES=4 GOLEM_WCP_PREFETCH_WINDOWS=1
# This is intentionally not auto-selected by run_noc_dma_pipeline.sh.

: "${GOLEM_WCP_CROSS_MACRO_PREFETCH_ENABLE:=1}"

: "${GOLEM_DMA_READ_RETRY_TICKS:=32}"
: "${GOLEM_DMA_READ_MAX_RETRIES:=8}"
: "${GOLEM_DMA_MAX_INFLIGHT:=256}"

: "${GOLEM_DMA_BURST_BYTES:=16384}"
: "${GOLEM_DMA_RESPONSE_DRAIN_LIMIT:=0}"

: "${GOLEM_A_REUSE_N_TILES:=8}"
: "${GOLEM_B_REUSE_M_TILES:=8}"

: "${GOLEM_DMA_WINDOW_K_TILES:=3}"


# 每核 GM 窗口（与 local layout / DMA flag 相关）
: "${GOLEM_GLOBAL_STRIDE_KB:=512}"

# Worker-private partial-C SRAM. The independent 1R1W ports each sustain one
# 64-array accumulator row (64 int32 values) per cycle.
: "${GOLEM_GM_C_BUFFER_BYTES:=1048576}"
: "${GOLEM_GM_C_BUFFER_READ_BPC:=256}"
: "${GOLEM_GM_C_BUFFER_WRITE_BPC:=256}"
: "${GOLEM_GM_C_BUFFER_LATENCY_CYCLES:=1}"
: "${GOLEM_FINAL_C_WRITE_ENABLE:=1}"
: "${GOLEM_OUTPUT_MODE:=}"
: "${GOLEM_DMA_WRITE_VN:=2}"

export GOLEM_DMA_STAGGER_CYCLES
export GOLEM_DMA_OVERLAP
export GOLEM_CTRL_OVERLAP_AB
export GOLEM_DMA_NODE_CHUNK_CREDITS
export GOLEM_DMA_PANEL_CHUNK_BYTES
export GOLEM_DMA_CREDIT_CHUNK_BYTES
export GOLEM_DMA_WINDOW_PRIORITY_ENABLE
export GOLEM_DMA_WINDOW_REORDER_CYCLES
export GOLEM_DMA_SLOT_COUNT
export GOLEM_REQUEST_SCHEDULER_QUEUE_DEPTH
export GOLEM_DMA_WINDOW_K_TILES
export GOLEM_SCHED_ISSUE_BUDGET_PER_TICK
export GOLEM_DMA_GROUP_RR_ENABLE
export GOLEM_DMA_TILE_CHUNK_QUANTUM
export GOLEM_DMA_RESPONSE_TILE_PRIORITY_ENABLE
export GOLEM_DMA_RESPONSE_REORDER_CYCLES
export GOLEM_DMA_RESPONSE_MAX_STARVATION_CYCLES
export GOLEM_DMA_ADMISSION_MAX_STARVATION_CYCLES
export GOLEM_SCHED_SUBMIT_BATCH_SIZE
export GOLEM_SCHED_DONE_BATCH_SIZE
export GOLEM_WCP_PREFETCH_WINDOWS
export GOLEM_WCP_CROSS_MACRO_PREFETCH_ENABLE
export GOLEM_DMA_READ_RETRY_TICKS
export GOLEM_DMA_READ_MAX_RETRIES
export GOLEM_DMA_MAX_INFLIGHT
export GOLEM_DMA_BURST_BYTES
export GOLEM_DMA_RESPONSE_DRAIN_LIMIT
export GOLEM_A_REUSE_N_TILES
export GOLEM_B_REUSE_M_TILES
export GOLEM_GLOBAL_STRIDE_KB
export GOLEM_GM_C_BUFFER_BYTES
export GOLEM_GM_C_BUFFER_READ_BPC
export GOLEM_GM_C_BUFFER_WRITE_BPC
export GOLEM_GM_C_BUFFER_LATENCY_CYCLES
export GOLEM_FINAL_C_WRITE_ENABLE
export GOLEM_OUTPUT_MODE
export GOLEM_DMA_WRITE_VN
